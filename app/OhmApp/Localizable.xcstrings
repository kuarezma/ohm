    "Onboarding.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm reads macOS process energy counters in joules without root access and shows battery minutes per app. Live system and GPU power are measured. CPU power is derived from process energy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm, macOS süreç enerji sayaçlarını root yetkisi olmadan joule olarak okur. Uygulama tüketimini pil dakikasıyla gösterir. Sistem ve GPU gücü canlı ölçülür. CPU gücü süreç enerjilerinden türetilir."
          }
        }
      }
    },
    "Onboarding.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background tasks can drain your battery. Ohm can move background or hidden apps to efficiency cores to reduce energy use. Savings depend on the workload."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan görevleri pilinizi tüketebilir. Ohm, arka plandaki veya gizli uygulamaları verimlilik çekirdeklerine yönlendirebilir. Tasarruf miktarı yapılan işe bağlıdır."
          }
        }
      }
    },
    "Onboarding.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm can pause eligible idle apps and resume them when brought to the front. A separate helper, ohm-thawd, watches Ohm and attempts to resume paused apps if Ohm stops."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm, uygun boştaki uygulamaları duraklatabilir ve ön plana alındığında sürdürebilir. Bağımsız ohm-thawd yardımcısı Ohm’u izler. Ohm kapanırsa duraklatılmış uygulamaları sürdürmeye çalışır."
          }
        }
      }
    },
