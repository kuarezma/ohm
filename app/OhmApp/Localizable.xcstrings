    "Onboarding.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm measures CPU Performance and Efficiency cluster power, GPU draw, and battery discharge directly from Apple Silicon hardware sensors without root privileges. Every milliwatt is tracked and attributed to the exact applications consuming it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm; CPU Performans ve Verimlilik küme gücünü, GPU çekimini ve pil deşarjını root yetkisi gerektirmeden doğrudan Apple Silicon donanım sensörlerinden ölçer. Her miliwatt izlenir ve tüketen uygulamalara tam olarak atfedilir."
          }
        }
      }
    },
    "Onboarding.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heavy background tasks can rapidly drain your battery. Ohm allows demoting background or hidden applications to your Mac's high-efficiency cores, saving up to 40% battery while keeping them running smoothly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağır arka plan görevleri pilinizi hızla tüketebilir. Ohm, arka plandaki veya gizli uygulamaları Mac'inizin yüksek verimlilik çekirdeklerine (E-core) yönlendirerek pilden %40'a varan tasarruf sağlar."
          }
        }
      }
    },
    "Onboarding.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm can pause idle applications using UNIX signals and resume them in under 300 ms the moment you bring them to the front. To ensure safety (ADR 0004 § 6), a separate lightweight watcher helper (ohm-thawd) monitors Ohm. Even if Ohm crashes or is forcefully quit, the watcher immediately unfreezes every application."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohm, boştaki uygulamaları UNIX sinyalleriyle duraklatır ve ön plana aldığınız anda 300 ms altında çözer. Güvenlik için (ADR 0004 § 6), bağımsız bir izleyici yardımcı (ohm-thawd) Ohm'u izler; Ohm çökse veya zorla kapatılsa bile tüm uygulamaları anında çözer."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
